<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>mgxs.h5</cross_sections>
    <material id="1" name="mat">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-2 1 -4 3 -6 5" universe="1"/>
    <surface id="1" type="x-plane" boundary="reflective" coeffs="0"/>
    <surface id="2" type="x-plane" boundary="reflective" coeffs="10.0"/>
    <surface id="3" type="y-plane" boundary="reflective" coeffs="0"/>
    <surface id="4" type="y-plane" boundary="reflective" coeffs="10.0"/>
    <surface id="5" type="z-plane" boundary="reflective" coeffs="0"/>
    <surface id="6" type="z-plane" boundary="reflective" coeffs="10.0"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>300</particles>
    <batches>15</batches>
    <inactive>5</inactive>
    <energy_mode>multi-group</energy_mode>
    <seed>1</seed>
    <random_ray>
      <distance_inactive>30.0</distance_inactive>
      <distance_active>200.0</distance_active>
      <ray_source>
        <source type="independent" strength="1.0" particle="neutron">
          <space type="box">
            <parameters>0 0 0 10.0 10.0 10.0</parameters>
          </space>
        </source>
      </ray_source>
      <source_shape>flat</source_shape>
      <source_region_meshes>
        <mesh id="1">
          <domain id="1" type="universe"/>
        </mesh>
      </source_region_meshes>
    </random_ray>
    <mesh id="1">
      <dimension>5 5 5</dimension>
      <lower_left>0 0 0</lower_left>
      <upper_right>10.0 10.0 10.0</upper_right>
    </mesh>
  </settings>
  <tallies>
    <mesh id="2">
      <dimension>3 3 3</dimension>
      <lower_left>0 0 0</lower_left>
      <upper_right>10.0 10.0 10.0</upper_right>
    </mesh>
    <filter id="1" type="mesh">
      <bins>2</bins>
    </filter>
    <tally id="1" name="scores">
      <filters>1</filters>
      <scores>flux fission nu-fission total</scores>
    </tally>
  </tallies>
</model>
